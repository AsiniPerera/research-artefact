# Copy to .env and fill in the password (or run: python set_db_password.py).
# Direct connection — needs IPv6 egress on the network:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.wxmyoommtwxsdashxzki.supabase.co:5432/postgres?sslmode=require

# Fallback if the network has no IPv6 — session pooler, works over IPv4 too.
# Note the different username (postgres.<project-ref>):
# DATABASE_URL=postgresql://postgres.wxmyoommtwxsdashxzki:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require

# If the password contains @ : / # ? or %, percent-encode it (@ -> %40).
